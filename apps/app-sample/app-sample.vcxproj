<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|PS3">
      <Configuration>Release</Configuration>
      <Platform>PS3</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A5E4D7B2-8C3F-4D1E-9F6A-2B5C8D7E1F4A}</ProjectGuid>
    <ProjectName>app-sample</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|PS3'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>GCC</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|PS3'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <OutDir>$(ProjectDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Configuration)\</IntDir>
    <TargetName>$(MSBuildProjectName).ppu</TargetName>
    <TargetExt>.elf</TargetExt>
    <ExtensionsToDeleteOnClean>*.pkg;*.obj;$(TargetPath);$(ExtensionsToDeleteOnClean)</ExtensionsToDeleteOnClean>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|PS3'">
    <ClCompile>
      <AdditionalIncludeDirectories>include;$(SolutionDir)libs\simple-ps3-lib\include;$(SCE_PS3_ROOT)\target\ppu\include;$(SCE_PS3_ROOT)\target\common\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>SN_TARGET_PS3;NDEBUG;__GCC__;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <OptimizationLevel>Level2</OptimizationLevel>
    </ClCompile>
    <Link>
      <AdditionalDependencies>-lsysmodule_stub;-lsysutil_stub;-lsysutil_game_stub;-lgcm_cmd;-lgcm_sys_stub;-lresc_stub;-lio_stub;-lpngdec_stub;-laudio_stub;-lfs_stub;-lfont_stub;-lfontFT_stub;-lfreetype_stub;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalOptions>-L"$(SolutionDir)libs\simple-ps3-lib\bin\$(Configuration)" -lsimple-ps3-lib</AdditionalOptions>
      <GccOutputFormat>ELFFile</GccOutputFormat>
    </Link>
    <PostBuildEvent>
      <Message>Packaging $(MSBuildProjectName).pkg</Message>
      <Command>cd /d "$(ProjectDir)"
if not exist "$(OutDir)USRDIR" mkdir "$(OutDir)USRDIR"
"$(SCE_PS3_ROOT)\host-win32\bin\make_fself_npdrm.exe" "$(TargetPath)" "$(OutDir)USRDIR\EBOOT.BIN"
xcopy /Y /E "$(ProjectDir)res\*" "$(OutDir)USRDIR\"
copy /Y PARAM.SFO "$(OutDir)PARAM.SFO"
copy /Y ICON0.PNG "$(OutDir)ICON0.PNG"
"$(SCE_PS3_ROOT)\host-win32\bin\make_package_npdrm.exe" $(MSBuildProjectName).conf "$(OutDir)."
if not exist "$(SolutionDir)out" mkdir "$(SolutionDir)out"
move /Y "$(ProjectDir)*.pkg" "$(SolutionDir)out\"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\main.c" />
    <ClCompile Include="src\overlays\stats.c" />
    <ClCompile Include="src\screens\demo.c" />
    <ClCompile Include="src\screens\palette.c" />
    <ClCompile Include="src\overlays\sidepanel.c" />
    <ClCompile Include="src\demos\bars.c" />
    <ClCompile Include="src\demos\bouncing-box.c" />
    <ClCompile Include="src\demos\gradient-tri.c" />
    <ClCompile Include="src\demos\animated-sprite.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="include\overlays\stats.h" />
    <ClInclude Include="include\bars.h" />
    <ClInclude Include="include\bouncing-box.h" />
    <ClInclude Include="include\gradient-tri.h" />
    <ClInclude Include="include\animated-sprite.h" />
    <ClInclude Include="include\screens\demo.h" />
    <ClInclude Include="include\screens\palette.h" />
    <ClInclude Include="include\overlays\sidepanel.h" />
  </ItemGroup>
  <ItemGroup>
    <CustomBuild Include="fpshader.cg">
      <FileType>Document</FileType>
      <Command Condition="'$(Configuration)|$(Platform)'=='Release|PS3'">cd /d "$(IntDir)."
"$(SCE_PS3_ROOT)\host-win32\Cg\bin\sce-cgc" -quiet -profile sce_fp_rsx -o "%(Filename).fpo" "%(FullPath)"
"$(SCE_PS3_ROOT)\host-win32\ppu\bin\ppu-lv2-objcopy" -I binary -O elf64-powerpc-celloslv2 -B powerpc "%(Filename).fpo" "%(Filename).ppu.o"</Command>
      <Outputs Condition="'$(Configuration)|$(Platform)'=='Release|PS3'">$(IntDir)%(Filename).ppu.o;%(Outputs)</Outputs>
    </CustomBuild>
    <CustomBuild Include="vpshader.cg">
      <FileType>Document</FileType>
      <Command Condition="'$(Configuration)|$(Platform)'=='Release|PS3'">cd /d "$(IntDir)."
"$(SCE_PS3_ROOT)\host-win32\Cg\bin\sce-cgc" -quiet -profile sce_vp_rsx -o "%(Filename).vpo" "%(FullPath)"
"$(SCE_PS3_ROOT)\host-win32\ppu\bin\ppu-lv2-objcopy" -I binary -O elf64-powerpc-celloslv2 -B powerpc "%(Filename).vpo" "%(Filename).ppu.o"</Command>
      <Outputs Condition="'$(Configuration)|$(Platform)'=='Release|PS3'">$(IntDir)%(Filename).ppu.o;%(Outputs)</Outputs>
    </CustomBuild>
  </ItemGroup>
  <ItemGroup>
    <None Include="app-sample.conf" />
    <None Include="PARAM.SFO" />
    <None Include="README.md" />
    <None Include="res\makoto.png" />
    <None Include="res\makoto.wav" />
    <None Include="res\pattern.png" />
    <None Include="res\price.ogg" />
    <None Include="ICON0.PNG" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
