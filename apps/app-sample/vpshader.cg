// vertex shader - position + color + texcoord pass-through
void main
(
	float4 position : POSITION,
	float4 color : COLOR,
	float2 texcoord : TEXCOORD0,
	out float4 oPosition : POSITION,
	out float4 oColor : COLOR,
	out float2 oTexcoord : TEXCOORD0
)
{
	oPosition = position;
	oColor = color;
	oTexcoord = texcoord;
}
