   <ClInclude Include="include\ui\graph.h" />
   <ClInclude Include="include\ui\temperature-unit.h" />
   <None Include="src\spu\spu-burn.c" />
   <ClInclude Include="include\screens\bench.h" />
  </ItemGroup>
  <ItemGroup>
