<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
   <ProjectConfiguration Include="Release|PS3">
     <Configuration>Release</Configuration>
     <Platform>PS3</Platform>
   </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
   <ProjectGuid>{C7F1A93D-4E62-4A08-9B31-6D2A5F0C8E77}</ProjectGuid>
   <ProjectName>thermal-bench</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|PS3'" Label="Configuration">
   <ConfigurationType>Application</ConfigurationType>
   <PlatformToolset>GCC</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|PS3'">
   <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
   <OutDir>$(ProjectDir)bin\$(Configuration)\</OutDir>
   <IntDir>$(ProjectDir)obj\$(Configuration)\</IntDir>
   <TargetName>$(MSBuildProjectName).ppu</TargetName>
   <TargetExt>.elf</TargetExt>
   <ExtensionsToDeleteOnClean>*.pkg;*.obj;$(TargetPath);$(ExtensionsToDeleteOnClean)</ExtensionsToDeleteOnClean>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|PS3'">
   <ClCompile>
     <AdditionalIncludeDirectories>include;$(SolutionDir)libs\simple-lib-app\include;$(SolutionDir)libs\simple-lib-core\include;$(SCE_PS3_ROOT)\target\ppu\include;$(SCE_PS3_ROOT)\target\common\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
     <PreprocessorDefinitions>SN_TARGET_PS3;NDEBUG;__GCC__;%(PreprocessorDefinitions)</PreprocessorDefinitions>
   </ClCompile>
   <Link>
     <AdditionalDependencies>-lsysmodule_stub;-lsysutil_stub;-lsysutil_game_stub;-lgcm_cmd;-lgcm_sys_stub;-lresc_stub;-lio_stub;-lpngdec_stub;-ljpgdec_stub;-laudio_stub;-lfs_stub;-lfont_stub;-lfontFT_stub;-lfreetype_stub;-lrtc_stub;-lnet_stub;-lnetctl_stub;-llv2_stub;%(AdditionalDependencies)</AdditionalDependencies>
     <AdditionalOptions>"$(IntDir)spuburn.o" -L"$(SolutionDir)libs\simple-lib-app\bin\$(Configuration)" -lsimple-lib-app -L"$(SolutionDir)libs\simple-lib-core\bin\$(Configuration)" -lsimple-lib-core -Wl,--strip-unused-data</AdditionalOptions>
     <GccOutputFormat>ELFFile</GccOutputFormat>
   </Link>
   <PreBuildEvent>
     <Message>Generating PARAM.SFO from XML</Message>
     <Command>"$(SolutionDir)tools\xml-to-sfo\bin\xml-to-sfo.exe" "$(ProjectDir)PARAM.SFO.xml" "$(ProjectDir)PARAM.SFO"</Command>
   </PreBuildEvent>
  </ItemDefinitionGroup>
  <!--
   The SPU burn program is built by the separate SPU compiler, then wrapped into
   a PPU object so it travels inside the app's own binary (no extra file to ship
   and nothing to sign). The objcopy-style-symbol option names the bytes after
   the intermediate elf, as _binary_spuburn_elf_start - which is what stress.c
   declares, so the intermediate name below is load-bearing (the source file
   name is not).
  -->
  <Target Name="BuildSpuBurn" BeforeTargets="ClCompile">
   <MakeDir Directories="$(IntDir)" />
   <Exec Command="&quot;$(SCE_PS3_ROOT)\host-win32\spu\bin\spu-lv2-gcc.exe&quot; -O2 -I&quot;$(SCE_PS3_ROOT)\target\spu\include&quot; -I&quot;$(SCE_PS3_ROOT)\target\common\include&quot; -o &quot;$(IntDir)spuburn.elf&quot; &quot;$(ProjectDir)src\spu\spu-burn.c&quot;" />
   <Exec Command="&quot;$(SCE_PS3_ROOT)\host-win32\bin\spu_elf-to-ppu_obj.exe&quot; --objcopy-style-symbol spuburn.elf spuburn.o" WorkingDirectory="$(IntDir)" />
  </Target>
