<Window x:Class="CellStreamServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cell Stream Server" Height="420" Width="560" MinHeight="300" MinWidth="420"
        Background="{StaticResource BgBase}"
        WindowStartupLocation="CenterScreen">

   <Grid Margin="16">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal">
         <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource BrIdle}" VerticalAlignment="Center" />
         <TextBlock x:Name="StatusText" Style="{StaticResource TextStatus}" Margin="10,0,0,0"
                    VerticalAlignment="Center" Text="Waiting for a PS3 ..." />
      </StackPanel>

      <TextBlock Grid.Row="1" x:Name="SettingsText" Style="{StaticResource TextDim}" Margin="22,6,0,0" TextWrapping="Wrap" />

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
         <Button x:Name="StartStopButton" Width="90" Content="Stop" Click="OnStartStopClicked" />
         <TextBlock Text="Encoder" Style="{StaticResource TextDim}" Margin="18,0,8,0" VerticalAlignment="Center" />
         <ComboBox x:Name="EncoderChoice" Width="220" SelectionChanged="OnEncoderChosen" VerticalAlignment="Center" />
      </StackPanel>

      <CheckBox Grid.Row="3" x:Name="StartWithWindows" Margin="0,16,0,0" Content="Start with Windows" />

      <TextBlock Grid.Row="4" Style="{StaticResource TextDim}" Margin="0,10,0,8" TextWrapping="Wrap"
                 Text="Closing this window leaves the server running in the notification area. Exit from the tray icon to stop it." />

      <TextBox Grid.Row="5" x:Name="LogBox" Style="{StaticResource LogBox}" />
   </Grid>
</Window>
