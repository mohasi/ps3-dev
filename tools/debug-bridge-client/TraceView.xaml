<UserControl x:Class="DebugBridgeClient.TraceView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:local="clr-namespace:DebugBridgeClient"
          Background="{StaticResource BgBase}">

   <UserControl.Resources>

     <!-- FlatButton and DarkTextBox live in Theme.xaml (shared app-wide). -->

     <!-- shared GridView column header style. resolves from both GridViews
         below via {StaticResource FlatHeader} through the logical tree. -->
     <Style x:Key="FlatHeader" TargetType="GridViewColumnHeader">
       <Setter Property="Background" Value="{StaticResource BgSurface}" />
       <Setter Property="Foreground" Value="{StaticResource FgText}" />
       <Setter Property="BorderBrush" Value="{StaticResource BrBorder}" />
       <Setter Property="BorderThickness" Value="0,0,1,1" />
       <Setter Property="Padding" Value="6,3" />
       <Setter Property="HorizontalContentAlignment" Value="Left" />
       <Setter Property="OverridesDefaultStyle" Value="True" />
       <Setter Property="Template">
         <Setter.Value>
            <ControlTemplate TargetType="GridViewColumnHeader">
              <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBright}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
         </Setter.Value>
       </Setter>
     </Style>

     <!-- flat ListViewItem: inner border on hover/selection that reads as
         3d in dark mode. replaced with a plain Border whose Background
         follows triggers, so selected/hovered/matched rows are solid. -->
     <Style x:Key="FlatRow" TargetType="ListViewItem">
       <Setter Property="Background" Value="Transparent" />
       <Setter Property="Foreground" Value="{StaticResource FgText}" />
       <Setter Property="BorderThickness" Value="0" />
       <Setter Property="Padding" Value="0" />
       <Setter Property="SnapsToDevicePixels" Value="True" />
       <Setter Property="Template">
         <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderThickness="0"
                    SnapsToDevicePixels="True">
                <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                 Content="{TemplateBinding Content}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSurface}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
         </Setter.Value>
       </Setter>
       <Style.Triggers>
         <!-- matched-by-search rows: solid accent fill, wins over hover
             but not over selection. -->
         <DataTrigger Binding="{Binding IsMatch}" Value="True">
            <Setter Property="Background" Value="{StaticResource BgHighlight}" />
         </DataTrigger>
       </Style.Triggers>
     </Style>

   </UserControl.Resources>

   <Grid>
     <Grid.RowDefinitions>
       <RowDefinition Height="Auto" />
       <RowDefinition Height="Auto" />
       <RowDefinition Height="*" />
       <RowDefinition Height="Auto" />
       <RowDefinition Height="180" />
     </Grid.RowDefinitions>

     <!-- single toolbar row:
         [Start] [Stop] [module] [Incl. Deps]   ...   Search:[box] [Refresh] -->
     <DockPanel Grid.Row="0"
             Margin="6,6,6,4"
             LastChildFill="False">

       <Button x:Name="startButton"
             DockPanel.Dock="Left"
             Content="Start"
             Style="{StaticResource FlatButton}"
             Margin="0,0,4,0"
             Click="OnStart" />

       <Button x:Name="stopButton"
             DockPanel.Dock="Left"
             Content="Stop"
             Style="{StaticResource FlatButton}"
             Margin="0,0,8,0"
             IsEnabled="False"
             Click="OnStop" />

       <Grid DockPanel.Dock="Left"
            Width="160"
            Margin="0,0,6,0">
         <TextBox x:Name="moduleBox"
                Style="{StaticResource DarkTextBox}"
                TextChanged="OnModuleTextChanged"
                KeyDown="OnModuleKeyDown" />
         <TextBlock x:Name="modulePlaceholder"
                  Text="module (e.g. SimpleFtp)"
                  IsHitTestVisible="False"
                  Foreground="{StaticResource FgTextDim}"
                  Margin="6,0,10,0"
                  VerticalAlignment="Center" />
       </Grid>

       <CheckBox x:Name="depsCheck"
               DockPanel.Dock="Left"
               Content="Incl. Deps"
               Foreground="{StaticResource FgText}"
               VerticalAlignment="Center"
               Margin="0,0,8,0" />

       <Button x:Name="refreshButton"
             DockPanel.Dock="Right"
             Content="Refresh"
             Style="{StaticResource FlatButton}"
             Margin="6,0,0,0"
             Click="OnRefresh" />

       <Grid DockPanel.Dock="Right" Width="160">
         <TextBox x:Name="filterBox"
                Style="{StaticResource DarkTextBox}"
                TextChanged="OnFilterChanged"
                KeyDown="OnFilterKeyDown" />
         <TextBlock x:Name="filterPlaceholder"
                  Text="search name/nid etc."
                  IsHitTestVisible="False"
                  Foreground="{StaticResource FgTextDim}"
                  Margin="6,0,10,0"
                  VerticalAlignment="Center" />
       </Grid>

     </DockPanel>

     <!-- status line: small, dim, no separator -->
     <TextBlock x:Name="statusText"
             Grid.Row="1"
             Margin="8,0,8,4"
             Foreground="{StaticResource FgTextDim}"
             FontSize="11"
             Text="idle" />

     <!-- one row per outgoing import call, in capture order. no top border
         so the toolbar and grid blend into one surface. -->
     <ListView x:Name="grid"
            Grid.Row="2"
            Background="{StaticResource BgBase}"
            Foreground="{StaticResource FgText}"
            BorderThickness="0"
            FontFamily="Consolas"
            FontSize="12"
            ItemContainerStyle="{StaticResource FlatRow}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            VirtualizingStackPanel.IsVirtualizing="True"
            VirtualizingStackPanel.VirtualizationMode="Recycling"
            SelectionChanged="OnRowSelectionChanged">
       <ListView.View>
         <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
            <GridViewColumn Header="#"
                        Width="60"
                        DisplayMemberBinding="{Binding Index}" />
            <GridViewColumn Header="Module"
                        Width="220"
                        DisplayMemberBinding="{Binding Module}" />
            <GridViewColumn Header="NID"
                        Width="110"
                        DisplayMemberBinding="{Binding NidHex}" />
            <GridViewColumn Header="Name"
                        Width="320"
                        DisplayMemberBinding="{Binding Name}" />
         </GridView>
       </ListView.View>
     </ListView>

     <!-- thicker divider so the details pane reads as a separate band. -->
     <Border Grid.Row="3" Height="3" Background="{StaticResource BrBorder}" />

     <!-- details pane: param table on the left, anomaly heatmap on the
         right. the heatmap encodes one cell per event in capture order,
         color = call rarity, so unusual calls pop visually. -->
     <Grid Grid.Row="4">
       <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="260" />
       </Grid.ColumnDefinitions>

       <ListView x:Name="detailsParams"
               Grid.Column="0"
               Background="{StaticResource BgBase}"
               Foreground="{StaticResource FgText}"
               BorderThickness="0"
               FontFamily="Consolas"
               FontSize="12"
               ItemContainerStyle="{StaticResource FlatRow}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto">
         <ListView.View>
            <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
              <GridViewColumn Header="reg"
                          Width="50"
                          DisplayMemberBinding="{Binding Reg}" />
              <GridViewColumn Header="name"
                          Width="130"
                          DisplayMemberBinding="{Binding Name}" />
              <GridViewColumn Header="type"
                          Width="130"
                          DisplayMemberBinding="{Binding Type}" />
              <GridViewColumn Header="value"
                          Width="150"
                          DisplayMemberBinding="{Binding Value}" />
            </GridView>
         </ListView.View>
       </ListView>

       <Border Grid.Column="1" Width="3" Background="{StaticResource BrBorder}" />

       <ScrollViewer Grid.Column="2"
                  Margin="6"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
         <local:TraceHeatmap x:Name="heatmap" />
       </ScrollViewer>

     </Grid>
   </Grid>
</UserControl>