<Window x:Class="PatchStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patch Studio" Height="720" Width="1040"
        Background="{StaticResource BgBase}" Foreground="{StaticResource FgText}"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="BrEdited" Color="#E0A835" />
    <!-- checkerboard so texture transparency reads -->
    <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#242424"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#2c2c2c"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,8,8" /><RectangleGeometry Rect="8,8,8,8" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <DataTemplate x:Key="TextureTile">
      <Border Width="150" Margin="6" Background="{StaticResource BgSurface}" BorderThickness="1" Cursor="Hand">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BrBorder}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Edited}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrEdited}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <StackPanel>
            <Border Height="128" Background="{StaticResource Checker}">
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="6"
                     RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <TextBlock Text="{Binding Caption}" Margin="6,5,6,1" Foreground="{StaticResource FgText}" />
            <TextBlock Text="{Binding Hash}" Margin="6,0,6,6" Foreground="{StaticResource FgTextDim}" FontFamily="Consolas" FontSize="11" />
          </StackPanel>
          <!-- edited badge: amber pencil, top-right -->
          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Padding="4,1"
                  Background="{StaticResource BrEdited}" Visibility="{Binding EditedVisibility}">
            <TextBlock Text="✎ edited" Foreground="#1e1e1e" FontSize="11" FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
   <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1" Padding="10,8">
      <DockPanel>
        <Button Content="New…" Style="{StaticResource FlatButton}" Click="NewProject_Click" />
        <Button Content="Open…" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="OpenProject_Click" />
        <Button Content="Save" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="Save_Click" />
        <Button Content="Fetch Dump" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="DownloadDump_Click" />
        <Button Content="Build" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="BuildPatch_Click" />
        <Button Content="Deploy" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="Deploy_Click" />
        <TextBlock x:Name="statusText" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Foreground="{StaticResource FgTextDim}" Text="No project open" />
      </DockPanel>
    </Border>

    <ListBox x:Name="gallery" ItemTemplate="{StaticResource TextureTile}" MouseDoubleClick="Gallery_DoubleClick"
             PreviewMouseRightButtonDown="Gallery_RightButtonDown"
             Background="Transparent" BorderThickness="0" Padding="6" Focusable="False"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ContextMenu>
        <ContextMenu Opened="TileMenu_Opened">
          <MenuItem x:Name="editMenuItem" Header="Edit" Click="EditMenu_Click" ToolTipService.ShowOnDisabled="True" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <!-- strip the default ListBoxItem chrome so only our tile shows -->
        <Style TargetType="ListBoxItem">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel>

   <!-- busy overlay: dims the window and spins while an FTP transfer runs (blocks input by covering it) -->
   <Border x:Name="busyOverlay" Background="#B0000000" Visibility="Collapsed">
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
       <Path x:Name="spinner" Width="44" Height="44" Stroke="{StaticResource FgText}" StrokeThickness="4"
             StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"
             Data="M 22,3 A 19,19 0 1 1 3,22">
         <Path.RenderTransform>
           <RotateTransform x:Name="spinnerRotation" Angle="0" />
         </Path.RenderTransform>
       </Path>
       <TextBlock x:Name="busyText" Margin="0,16,0,0" HorizontalAlignment="Center"
                  Foreground="{StaticResource FgText}" FontSize="14" />
     </StackPanel>
   </Border>
  </Grid>
</Window>
