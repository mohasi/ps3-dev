<Window x:Class="PatchStudio.SelectDumpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Dump" Height="360" Width="360" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgBase}" Foreground="{StaticResource FgText}"
        FontFamily="Segoe UI" FontSize="13">
  <DockPanel Margin="18">
    <TextBlock DockPanel.Dock="Top" Text="Pick a game to pull its texture dump" Foreground="{StaticResource FgTextDim}" Margin="0,0,0,10" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Style="{StaticResource FlatButton}" Click="Cancel_Click" IsCancel="True" MinWidth="80" />
      <Button Content="Download" Style="{StaticResource FlatButton}" Click="Ok_Click" IsDefault="True" Margin="8,0,0,0" MinWidth="80" />
    </StackPanel>
    <ListBox x:Name="list" MouseDoubleClick="List_DoubleClick"
             Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BrBorder}" Foreground="{StaticResource FgText}" />
  </DockPanel>
</Window>
