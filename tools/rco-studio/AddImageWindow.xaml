<Window x:Class="RcoStudio.AddImageWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add image"
      Width="420"
      SizeToContent="Height"
      ResizeMode="NoResize"
      WindowStartupLocation="CenterOwner"
      Background="{StaticResource BgBase}">

   <StackPanel Margin="14">
     <TextBlock x:Name="summaryText" Foreground="{StaticResource FgText}" TextWrapping="Wrap" />

     <TextBlock Text="Format for the new image" Foreground="{StaticResource FgText}" Margin="0,14,0,4" />
     <ListBox x:Name="formatList"
            Height="150"
            Background="{StaticResource BgSurface}"
            Foreground="{StaticResource FgText}"
            BorderBrush="{StaticResource BrBorder}">
       <ListBox.ItemContainerStyle>
         <Style TargetType="ListBoxItem">
           <Setter Property="Foreground" Value="{StaticResource FgText}" />
           <Setter Property="Padding" Value="6,3" />
           <Setter Property="Template">
             <Setter.Value>
               <ControlTemplate TargetType="ListBoxItem">
                 <Border x:Name="itemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                   <ContentPresenter />
                 </Border>
                 <ControlTemplate.Triggers>
                   <Trigger Property="IsMouseOver" Value="True">
                     <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BgHover}" />
                   </Trigger>
                   <Trigger Property="IsSelected" Value="True">
                     <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BgHighlight}" />
                   </Trigger>
                 </ControlTemplate.Triggers>
               </ControlTemplate>
             </Setter.Value>
           </Setter>
         </Style>
       </ListBox.ItemContainerStyle>
     </ListBox>

     <TextBlock x:Name="hintText" Foreground="{StaticResource FgTextDim}" TextWrapping="Wrap" Margin="0,8,0,0" />

     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
       <Button Content="Add" Width="80" Style="{StaticResource FlatButton}" IsDefault="True" Click="OnAdd" />
       <Button Content="Cancel" Width="80" Margin="8,0,0,0" Style="{StaticResource FlatButton}" IsCancel="True" />
     </StackPanel>
   </StackPanel>
</Window>
