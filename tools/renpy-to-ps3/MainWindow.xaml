<Window x:Class="RenpyToPs3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ren'Py to PS3" Height="620" Width="780" MinHeight="420" MinWidth="620"
        Background="{StaticResource BgBase}"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Task:" Style="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="TaskChoice" Grid.Column="1" Width="280" HorizontalAlignment="Left" SelectionChanged="OnTaskChosen" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="InputLabel" Style="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Grid Grid.Column="1">
        <TextBox x:Name="InputBox" Style="{StaticResource DarkTextBox}" Height="24" TextChanged="OnPathTextChanged" />
        <TextBlock x:Name="InputHint" Style="{StaticResource TextDim}" IsHitTestVisible="False" Margin="6,0,10,0" VerticalAlignment="Center" />
      </Grid>
      <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0" Click="OnBrowseInput" />
    </Grid>

    <Grid x:Name="OutputRow" Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Output:" Style="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Grid Grid.Column="1">
        <TextBox x:Name="OutputBox" Style="{StaticResource DarkTextBox}" Height="24" TextChanged="OnPathTextChanged" />
        <TextBlock x:Name="OutputHint" Style="{StaticResource TextDim}" IsHitTestVisible="False" Margin="6,0,10,0" VerticalAlignment="Center" />
      </Grid>
      <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0" Click="OnBrowseOutput" />
    </Grid>

    <Grid x:Name="PackOptionsRow" Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Max image size:" Style="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                 ToolTip="Images larger than this (longest edge, in pixels) are shrunk to fit" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <TextBox x:Name="MaxEdgeBox" Style="{StaticResource DarkTextBox}" Width="52" Height="24" Margin="0,0,4,0" Text="1920" />
        <TextBlock Text="px" Style="{StaticResource TextDim}" VerticalAlignment="Center" />
        <CheckBox x:Name="AsciiTextCheck" Content="Use plain quotes/dots" Margin="20,0,0,0" VerticalAlignment="Center"
                  ToolTip="Some fonts can't show curly quotes or the single-character ellipsis; this swaps them for plain &quot; and ..." />
        <CheckBox x:Name="NoCacheCheck" Content="No cache" Margin="16,0,0,0" VerticalAlignment="Center"
                  ToolTip="Re-encode every asset instead of reusing results from earlier packs" />
        <CheckBox x:Name="ClearCacheCheck" Content="Clear cache" Margin="16,0,0,0" VerticalAlignment="Center"
                  ToolTip="Wipe the asset cache first, then pack and rebuild it" />
      </StackPanel>
    </Grid>

    <Grid x:Name="AstLabelRow" Grid.Row="4" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Label (optional):" Style="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="AstLabelBox" Grid.Column="1" Style="{StaticResource DarkTextBox}" Width="200" Height="24" HorizontalAlignment="Left"
               ToolTip="Also report where this script label sits in the tree" />
    </Grid>

    <TextBox Grid.Row="5" x:Name="LogView" Style="{StaticResource LogBox}" Margin="0,12,0,0" />

    <Grid Grid.Row="6" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="RunButton" Content="Run" Width="90" Click="OnRun" />
        <Button Content="Clear Log" Margin="8,0,0,0" Click="OnClearLog" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Style="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
