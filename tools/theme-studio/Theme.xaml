<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- see dev/tools/UI-GUIDELINES.md. every number here comes from the spacing scale in that
       file; nothing is picked by eye, and nothing outside these styles sets its own spacing. -->

  <Color x:Key="ColorBase">#1e1e1e</Color>
  <Color x:Key="ColorCard">#252526</Color>
  <Color x:Key="ColorSurface">#2d2d2d</Color>
  <Color x:Key="ColorSurfaceHover">#3e3e3e</Color>
  <Color x:Key="ColorSurfaceHigh">#5a5a5a</Color>
  <Color x:Key="ColorBorder">#3f3f3f</Color>
  <Color x:Key="ColorText">#cccccc</Color>
  <Color x:Key="ColorTextDim">#8a8a8a</Color>
  <Color x:Key="ColorHighlight">#3c5a78</Color>
  <Color x:Key="ColorGreen">#3d7a35</Color>
  <Color x:Key="ColorGreenBright">#4d9642</Color>
  <Color x:Key="ColorGreenDim">#2f5f2a</Color>

  <SolidColorBrush x:Key="BgBase" Color="{StaticResource ColorBase}"/>
  <SolidColorBrush x:Key="BgCard" Color="{StaticResource ColorCard}"/>
  <SolidColorBrush x:Key="BgSurface" Color="{StaticResource ColorSurface}"/>
  <SolidColorBrush x:Key="BgHover" Color="{StaticResource ColorSurfaceHover}"/>
  <SolidColorBrush x:Key="BgHoverBright" Color="{StaticResource ColorSurfaceHigh}"/>
  <SolidColorBrush x:Key="BrBorder" Color="{StaticResource ColorBorder}"/>
  <SolidColorBrush x:Key="FgText" Color="{StaticResource ColorText}"/>
  <SolidColorBrush x:Key="FgTextDim" Color="{StaticResource ColorTextDim}"/>
  <SolidColorBrush x:Key="BgHighlight" Color="{StaticResource ColorHighlight}"/>
  <SolidColorBrush x:Key="BgGreen" Color="{StaticResource ColorGreen}"/>
  <SolidColorBrush x:Key="BgGreenBright" Color="{StaticResource ColorGreenBright}"/>
  <SolidColorBrush x:Key="BgGreenDim" Color="{StaticResource ColorGreenDim}"/>

  <!-- the spacing scale, named so code-built rows use the same values as the xaml -->
  <sys:Double x:Key="SpaceLabel">4</sys:Double>
  <sys:Double x:Key="SpaceRow">8</sys:Double>
  <sys:Double x:Key="SpaceField">12</sys:Double>
  <sys:Double x:Key="SpaceCard">16</sys:Double>
  <sys:Double x:Key="SpacePage">20</sys:Double>
  <sys:Double x:Key="ControlHeight">32</sys:Double>
  <!-- a card is as wide as a form field should ever be; cards wrap into columns to fill
       the window, rather than one column stretching to an unreadable width -->
  <sys:Double x:Key="CardWidth">460</sys:Double>

  <Thickness x:Key="PadPage">20</Thickness>
  <Thickness x:Key="PadCard">16</Thickness>
  <Thickness x:Key="GapAfterLabel">0,0,0,4</Thickness>
  <Thickness x:Key="GapAfterField">0,0,0,12</Thickness>
  <!-- cards wrap into columns, so they need the gap on the right as much as underneath, or two
       side by side read as one box -->
  <Thickness x:Key="GapAfterCard">0,0,16,16</Thickness>

  <!-- text -->

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="{StaticResource GapAfterLabel}"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource FgTextDim}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <!-- a group of related fields, on its own surface with a heading -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="{StaticResource PadCard}"/>
    <Setter Property="Margin" Value="{StaticResource GapAfterCard}"/>
  </Style>

  <!-- controls: all 32 high, so a box, a dropdown and a button line up in a row -->

  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource BgSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="face" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="0" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgHoverBright}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a button that opens a menu. it carries the same chevron as a dropdown, because that is what
       it does. a plain button suggests it acts on its own. -->
  <Style x:Key="Dropdown" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="12,0,32,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="face" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="0"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource FgText}" Margin="0,0,-20,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgHoverBright}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- the one button that keeps your work. it is green because it is the only thing on the strip
       that is not a place to go, and it is the one you want to find without looking. -->
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource BgGreen}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BgGreenBright}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="face" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgGreenBright}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgGreenDim}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a button with no face of its own, for an icon tile: the picture inside shows the hover, so
       the highlight never covers the clear cross on the tile's corner -->
  <ControlTemplate x:Key="PlainTile" TargetType="Button">
    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource BgSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Style.Triggers>
      <!-- a box holding many lines starts at the top and sets its own padding -->
      <Trigger Property="AcceptsReturn" Value="True">
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Padding" Value="8"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- the wizard's stage strip. the stage number rides in a ring in front of its name, so the
       order is readable at a glance rather than being part of the title text -->
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid>
            <Border x:Name="face" Padding="14,7" Margin="0,0,1,0" Background="{StaticResource BgSurface}">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="ring" Width="20" Height="20" CornerRadius="10" Margin="0,0,8,0"
                        Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource FgTextDim}">
                  <TextBlock x:Name="number" Text="{TemplateBinding Tag}" FontSize="11"
                             Foreground="{StaticResource FgTextDim}" HorizontalAlignment="Center"/>
                </Border>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <!-- a Border cannot draw a dashed edge, so the stage you are on is outlined by a
                 rectangle laid over it -->
            <Rectangle x:Name="dashes" Margin="0,0,1,0" Visibility="Collapsed"
                       Stroke="{StaticResource FgTextDim}" StrokeThickness="1" StrokeDashArray="3 2"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgBase}"/>
              <Setter TargetName="dashes" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ring" Property="Background" Value="{StaticResource BgHighlight}"/>
              <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource BgHighlight}"/>
              <Setter TargetName="number" Property="Foreground" Value="White"/>
              <Setter Property="Foreground" Value="{StaticResource FgText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- tooltips and menus come from the system in white unless they are given a face of their own -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BrBorder}"
                  BorderThickness="1" Padding="8,5">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BrBorder}"
                  BorderThickness="1" Padding="0,4">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="face" Background="Transparent" Padding="14,7">
            <StackPanel>
              <ContentPresenter ContentSource="Header"/>
              <!-- what the example does, on the row itself: a tooltip would hide it until hovered -->
              <TextBlock Text="{TemplateBinding InputGestureText}" FontSize="11"
                         Foreground="{StaticResource FgTextDim}" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{StaticResource BgBase}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <TabPanel DockPanel.Dock="Top" IsItemsHost="True" HorizontalAlignment="Left"
                      Margin="0,0,0,16"/>
            <!-- the name matters: without it the stage's contents are invisible to accessibility
                 tools and to anything else that reads the window -->
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a pair of these makes a two-way switch, mutually exclusive without any extra code -->
  <Style x:Key="Toggle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource FgTextDim}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="face" Background="{StaticResource BgSurface}" CornerRadius="0"
                  BorderBrush="{StaticResource BrBorder}" BorderThickness="1" Padding="16,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgHover}"/>
              <Setter Property="Foreground" Value="{StaticResource FgText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press" Margin="0"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="face" Background="{StaticResource BgSurface}" CornerRadius="0"
                          BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                    <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource FgText}" Margin="0,0,12,0"
                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="face" Property="Background" Value="{StaticResource BgHover}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="8,0,28,0" IsHitTestVisible="False" VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                   Focusable="False">
              <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BrBorder}"
                      BorderThickness="1" CornerRadius="0" Margin="0,4,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer MaxHeight="320">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="face" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Border Height="4" VerticalAlignment="Center" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1"/>
            <Track Name="PART_Track">
              <Track.Thumb>
                <Thumb Width="12" Height="20">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{StaticResource BgHoverBright}" BorderThickness="1"
                              BorderBrush="{StaticResource BrBorder}"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource BgSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="4"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource FgText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="face" Background="Transparent" CornerRadius="0"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource BgHighlight}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a thin flat scrollbar: a track and a thumb, no arrow buttons -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="thumb" Background="{StaticResource BgHover}" CornerRadius="0" Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="thumb" Property="Background" Value="{StaticResource BgHoverBright}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="12"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- rows in the 3D scene list: the blue selection fills the whole width edge to edge, with no
       gap down either side, and long lines wrap rather than scroll sideways -->
  <Style x:Key="SceneList" TargetType="ListBox">
    <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{StaticResource BgCard}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Padding" Value="8,6"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="fill" Background="Transparent" Padding="{TemplateBinding Padding}">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="fill" Property="Background" Value="{StaticResource BgHighlight}"/>
                  </Trigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="IsSelected" Value="False"/>
                      <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="fill" Property="Background" Value="{StaticResource BgHover}"/>
                  </MultiTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a menu colour drawn from data. a combo box moves the chosen item's visual into its popup,
       so an item built from live controls disappears from the closed box the moment it opens -->
  <DataTemplate x:Key="ColourChoiceRow">
    <StackPanel Orientation="Horizontal">
      <Border Width="32" Height="16" Margin="0,0,12,0" CornerRadius="2" BorderThickness="1"
              BorderBrush="{StaticResource BrBorder}" Background="{Binding Swatch}"/>
      <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
